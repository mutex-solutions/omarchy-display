<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets the Display plugin re-detect a monitor through pkexec. Exactly one
     program, and only for the active local session. auth_admin_keep asks once,
     then not again for about five minutes. -->
<policyconfig>
  <vendor>mutex-solutions</vendor>
  <vendor_url>https://github.com/mutex-solutions/omarchy-display</vendor_url>
  <action id="com.mutex-solutions.display.redetect">
    <description>Re-detect a monitor</description>
    <message>Authentication is required to re-detect a monitor (like unplugging and replugging its cable)</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/omarchy-display-redetect</annotate>
  </action>
</policyconfig>
